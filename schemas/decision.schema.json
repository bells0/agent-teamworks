{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bells0/agent-teamworks/main/schemas/decision.schema.json",
  "title": "Agent Teamworks Decision",
  "description": "A consequential project choice with authority and history.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "team_id",
    "title",
    "status",
    "authority_ref",
    "context",
    "choice",
    "rationale",
    "evidence",
    "affects",
    "supersedes",
    "created_at",
    "decided_at"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "decision_id": { "$ref": "#/$defs/id" },
    "team_id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["proposed", "approved", "rejected", "superseded"]
    },
    "authority_ref": { "type": "string", "minLength": 1 },
    "context": { "type": "string", "minLength": 1 },
    "choice": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "affects": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "minItems": 1,
      "uniqueItems": true
    },
    "supersedes": {
      "anyOf": [
        { "$ref": "#/$defs/id" },
        { "type": "null" }
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "decided_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["approved", "rejected", "superseded"] }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "decided_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    }
  }
}
