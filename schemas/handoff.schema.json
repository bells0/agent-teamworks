{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bells0/agent-teamworks/main/schemas/handoff.schema.json",
  "title": "Agent Teamworks Handoff",
  "description": "A continuity record between roles or successive bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "team_id",
    "type",
    "from_role_id",
    "to_role_id",
    "from_generation",
    "to_generation",
    "from_agent_ref",
    "to_agent_ref",
    "status",
    "reason",
    "context_snapshot",
    "completed_outputs",
    "open_items",
    "decisions",
    "evidence",
    "destination_acknowledged",
    "prepared_at"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "handoff_id": { "$ref": "#/$defs/id" },
    "team_id": { "$ref": "#/$defs/id" },
    "type": {
      "type": "string",
      "enum": ["role_succession", "ownership_transfer", "temporary_delegation"]
    },
    "from_role_id": { "$ref": "#/$defs/id" },
    "to_role_id": { "$ref": "#/$defs/id" },
    "from_generation": { "type": "integer", "minimum": 1 },
    "to_generation": { "type": "integer", "minimum": 1 },
    "from_agent_ref": { "type": "string", "minLength": 1 },
    "to_agent_ref": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["prepared", "acknowledged", "completed", "cancelled"]
    },
    "reason": { "type": "string", "minLength": 1 },
    "context_snapshot": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "completed_outputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "open_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "destination_acknowledged": { "type": "boolean" },
    "prepared_at": { "type": "string", "format": "date-time" },
    "completed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "completed" } },
        "required": ["status"]
      },
      "then": {
        "required": ["completed_at"],
        "properties": {
          "completed_at": { "type": "string", "format": "date-time" },
          "destination_acknowledged": { "const": true }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    }
  }
}
